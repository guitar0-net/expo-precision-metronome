{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],

  "minimumReleaseAge": "3 days",
  "prConcurrentLimit": 10,

  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "minimumReleaseAge": "0 days"
  },

  "schedule": ["before 6am on Saturday"],

  "labels": ["dependencies"],
  "commitMessagePrefix": "chore(deps):",
  "rebaseWhen": "conflicted",
  "separateMajorMinor": true,
  "major": {
    "labels": ["dependencies", "breaking-change"]
  },

  "packageRules": [
    {
      "matchDepTypes": ["devDependencies"],
      "labels": ["dependencies", "npm"]
    },

    {
      "description": "Expo patch updates within the current SDK. Wait 14 days before raising a PR.",
      "matchPackageNames": ["expo", "expo-module-scripts", "/^expo-/", "/^@expo\\//"],
      "groupName": "expo-sdk",
      "minimumReleaseAge": "14 days",
      "labels": ["dependencies", "expo-sdk"]
    },

    {
      "description": "react, react-native and their types are pinned by the Expo SDK; bump them with `npx expo install --fix` during an SDK upgrade.",
      "matchPackageNames": [
        "react",
        "react-native",
        "@types/react",
        "@types/react-native"
      ],
      "enabled": false
    },

    {
      "description": "A new Expo SDK is a manual migration (expo install --fix, Gradle/Kotlin/AGP), not a Renovate bump.",
      "matchPackageNames": ["expo", "expo-module-scripts", "/^expo-/", "/^@expo\\//"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },

    {
      "description": "The example app's Gradle wrapper must match the React Native template's AGP/Kotlin; update it with the SDK.",
      "matchManagers": ["gradle-wrapper"],
      "matchFileNames": ["example/android/**"],
      "enabled": false
    },

    {
      "matchPackageNames": [
        "@commitlint/cli",
        "@commitlint/config-conventional",
        "husky",
        "lint-staged"
      ],
      "groupName": "git-hooks-tooling"
    },

    {
      "matchPackageNames": [
        "eslint",
        "/^eslint-/",
        "/^@typescript-eslint\\//",
        "eslint-config-universe",
        "prettier"
      ],
      "groupName": "linting"
    },

    {
      "matchPackageNames": ["typescript", "ts-node", "tslib"],
      "groupName": "build-tooling"
    },

    {
      "matchManagers": ["github-actions"],
      "groupName": "github-actions",
      "labels": ["dependencies", "ci"]
    }
  ]
}
